# Developer Portal > application > Bot > Reset Token
DISCORD_BOT_TOKEN=replace_with_your_bot_token

# Optional: defaults shown below
BOT_TIMEZONE=Asia/Seoul
DATABASE_PATH=data/meetings.sqlite3

# Newsletter generation (OpenAI Responses API + web search)
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna
NEWS_SOURCE_LIST_PATH=docs/source-list.md

# Server/channel setup no longer lives here. Invite the bot to each server you
# want it in, then use /공지채널추가, /공지채널제거, /공지채널목록 in that server.
